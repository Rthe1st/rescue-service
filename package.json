{
  "name": "rescue-service",
  "version": "1.0.0",
  "description": "Hello World web game built with Phaser 4 and TypeScript",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "build": "vite build",
    "dev": "vite",
    "deploy": "vite build && wrangler pages deploy",
    "check-pr-description": "node scripts/check-pr-description.mjs",
    "test:layout": "playwright test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.14.0",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.1",
    "wrangler": "^4.129.0"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "phaser": "^4.2.1"
  }
}
